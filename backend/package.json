{
  "name": "ranniti-backend",
  "version": "1.0.0",
  "description": "Node.js + Express + TypeScript backend with clean layered architecture",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "seed": "tsx src/seeds/index.ts",
    "typecheck": "tsc --noEmit",
    "migrate:create": "node-pg-migrate -m src/database/migrations create",
    "migrate:up": "node-pg-migrate -m src/database/migrations up",
    "migrate:down": "node-pg-migrate -m src/database/migrations down",
    "migrate:redo": "node-pg-migrate -m src/database/migrations redo"
  },
  "keywords": [
    "nodejs",
    "express",
    "typescript",
    "clean-architecture",
    "rest-api"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "multer": "^2.4.0",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.0",
    "xlsx": "^0.18.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/exceljs": "^0.5.3",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
