{
  "name": "ranniti-backend",
  "version": "1.0.0",
  "description": "Node.js + Express + TypeScript backend with clean layered architecture",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc && node scripts/copy-migrations.js",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server.js",
    "seed": "tsx src/seeds/index.ts",
    "dev": "tsx watch src/server.ts",
    "migrate": "tsx src/scripts/migrateMaster.ts && tsx src/scripts/migrateTenants.ts",
    "migrate:master": "tsx src/scripts/migrateMaster.ts",
    "migrate:tenants": "tsx src/scripts/migrateTenants.ts",
    "test:voter-filters": "tsx src/scripts/testVoterFilters.ts",
    "test:autoupdate": "tsx src/scripts/testAutoUpdateSync.ts",
    "seed:volunteers": "tsx src/seeds/seeders/volunteer.seeder.ts",
    "seed:settings": "tsx src/seeds/seeders/setting.seeder.ts",
    "seed:whatsapp-templates": "tsx src/seeds/seeders/whatsapp_template.seeder.ts",
    "seed:parties": "tsx src/seeds/seeders/party.seeder.ts",
    "seed:roles": "tsx src/seeds/seeders/role.seeder.ts",
    "seed:tenant-roles": "tsx src/seeds/seeders/tenant_role.seeder.ts",
    "seed:tenant-user-roles": "tsx src/seeds/seeders/tenant_user_role.seeder.ts",
    "seed:backfill-family-ids": "tsx src/seeds/backfillFamilyIds.ts",
    "generate-sample": "tsx src/seeds/generate_sample_voters_file.ts",
    "generate:parties": "tsx src/seeds/generate_parties_import.ts",
    "create_religions_and_castes_tables": "tsx src/scripts/createReligionsAndCastesTables.ts",
    "create_voters_table": "tsx src/scripts/createVotersTable.ts",
    "clean:table": "tsx src/scripts/cleanTable.ts",
    "clean:test-voters": "tsx src/scripts/cleanTestVoters.ts",
    "clean:unused-locations": "tsx src/scripts/cleanUnusedMasterLocations.ts",
    "clean:redis": "tsx src/scripts/cleanRedisCache.ts",
    "clean:all-voters": "tsx src/scripts/cleanAllVoters.ts",
    "convert:101": "tsx src/scripts/convert101ExcelToRannitiFormat.ts",
    "generate:test-100k": "tsx src/scripts/generate100kTestVoters.ts",
    "generate:test-10k-other": "tsx src/scripts/generate10kOtherPcAcVoters.ts",
    "import:101": "tsx src/scripts/importAc101Voters.ts"
  },
  "keywords": [
    "nodejs",
    "express",
    "typescript",
    "clean-architecture",
    "rest-api"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.13",
    "pg": "^8.23.0",
    "pg-copy-streams": "^7.0.0",
    "sanitize-html": "^2.18.0",
    "xlsx": "^0.18.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/exceljs": "^0.5.3",
    "@types/express": "^5.0.0",
    "@types/ioredis": "^4.28.10",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.13.10",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/pg-copy-streams": "^1.2.5",
    "@types/sanitize-html": "^2.16.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
